.hero { position: relative; height: 980rpx; overflow: hidden; background: #0c2f21; }
.hero-image { width: 100%; height: 100%; }
.hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6,31,21,.12) 15%, rgba(6,31,21,.84) 86%); }
.hero-copy { position: absolute; left: 30rpx; right: 30rpx; bottom: 52rpx; color: #fff; }
.hero-kicker { display: block; color: #d7ecdb; font-size: 23rpx; font-weight: 800; letter-spacing: 3rpx; }
.hero-title { display: block; margin-top: 25rpx; font-family: "Songti SC", STSong, serif; font-size: 72rpx; font-weight: 900; line-height: 1.08; letter-spacing: -3rpx; white-space: pre-line; }
.hero-desc { display: block; max-width: 650rpx; margin-top: 24rpx; color: rgba(255,255,255,.76); font-size: 27rpx; line-height: 1.75; }
.hero-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 32rpx; }
.hero-ghost { color: #fff; border-color: rgba(255,255,255,.34); background: rgba(255,255,255,.1); }
.keyword-row { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 28rpx; background: var(--paper); }
.intro { background: var(--paper); }
.cycle-section { color: #fff; background: var(--pine); }
.section-head-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.light-heading { color: #fff; }
.swipe-tip { flex: none; padding-bottom: 10rpx; color: rgba(255,255,255,.5); font-size: 20rpx; }
.cycle-scroll { width: calc(100% + 56rpx); margin: 36rpx -28rpx 0; }
.cycle-list { display: flex; gap: 18rpx; width: max-content; padding: 0 28rpx 10rpx; }
.cycle-card { width: 270rpx; min-height: 360rpx; padding: 26rpx; border: 1rpx solid rgba(255,255,255,.13); border-radius: 28rpx; background: rgba(255,255,255,.06); }
.cycle-no { color: rgba(255,255,255,.38); font-size: 21rpx; letter-spacing: 3rpx; }
.cycle-mark { width: 84rpx; height: 84rpx; margin-top: 26rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(255,255,255,.25); border-radius: 50%; color: #f1d08d; font-family: "Songti SC", STSong, serif; font-size: 34rpx; font-weight: 900; }
.cycle-title { display: block; margin-top: 28rpx; font-family: "Songti SC", STSong, serif; font-size: 31rpx; font-weight: 900; }
.cycle-desc { display: block; margin-top: 10rpx; color: rgba(255,255,255,.58); font-size: 23rpx; line-height: 1.6; }
.quick-section { background: var(--cream); }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 26rpx; }
.quick-card { min-height: 270rpx; padding: 28rpx; }
.quick-index { color: var(--gold); font-size: 22rpx; font-weight: 900; }
.quick-title { display: block; margin-top: 48rpx; color: var(--pine); font-family: "Songti SC", STSong, serif; font-size: 34rpx; font-weight: 900; }
.quick-desc { display: block; margin-top: 8rpx; color: var(--muted); font-size: 22rpx; }
