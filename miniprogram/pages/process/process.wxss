.process-hero { position: relative; height: 820rpx; padding-top: 28rpx; }
.process-image { width: 100%; height: 100%; border-radius: 34rpx; }
.process-hero::after { content: ""; position: absolute; left: 28rpx; right: 28rpx; top: 28rpx; bottom: 0; border-radius: 34rpx; background: linear-gradient(180deg, transparent 38%, rgba(5,31,21,.86)); }
.process-caption { position: absolute; z-index: 2; left: 62rpx; right: 62rpx; bottom: 46rpx; color: #fff; }
.caption-kicker { display: block; color: #d9eddd; font-size: 23rpx; font-weight: 800; letter-spacing: 4rpx; }
.caption-title { display: block; margin-top: 18rpx; font-family: "Songti SC", STSong, serif; font-size: 54rpx; font-weight: 900; line-height: 1.2; white-space: pre-line; }
.stage-list { display: grid; gap: 16rpx; margin-top: 38rpx; }
.stage-card { display: grid; grid-template-columns: 86rpx 1fr; gap: 22rpx; padding: 25rpx; }
.stage-no { width: 78rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; color: #fff; background: var(--pine); font-family: "Songti SC", STSong, serif; font-size: 32rpx; font-weight: 900; }
.stage-title { display: block; color: var(--pine); font-family: "Songti SC", STSong, serif; font-size: 32rpx; font-weight: 900; }
.stage-desc { display: block; margin-top: 7rpx; color: var(--muted); font-size: 24rpx; line-height: 1.7; }
.acid-card { margin-top: 18rpx; padding: 28rpx; border-radius: 28rpx; color: var(--pine); background: #f0ddb3; }
.acid-title { display: block; font-size: 29rpx; font-weight: 900; }
.acid-desc { display: block; margin-top: 7rpx; color: rgba(16,60,42,.72); font-size: 24rpx; }
.flow-section { color: #fff; background: var(--pine); }
.light-kicker { color: #a8cdae; }
.light-title { color: #fff; }
.flow-list { margin-top: 38rpx; border-top: 1rpx solid rgba(255,255,255,.15); }
.flow-item { display: flex; align-items: center; gap: 28rpx; padding: 29rpx 2rpx; border-bottom: 1rpx solid rgba(255,255,255,.15); }
.flow-num { color: #e9c36f; font-size: 21rpx; letter-spacing: 3rpx; }
.flow-title { font-family: "Songti SC", STSong, serif; font-size: 34rpx; font-weight: 900; }
