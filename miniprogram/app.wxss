page{background:#f7f3e7;color:#203128;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:24rpx 24rpx 50rpx}.hero{height:410rpx;border-radius:30rpx;overflow:hidden;position:relative}.hero image{width:100%;height:100%}.overlay{position:absolute;inset:0;background:linear-gradient(0deg,rgba(8,35,24,.82),rgba(8,35,24,.05));display:flex;flex-direction:column;justify-content:flex-end;padding:30rpx;color:white}.hero-title{font-size:52rpx;font-weight:800}.hero-sub{font-size:25rpx;margin-top:8rpx}.section{margin-top:28rpx}.title{font-size:36rpx;font-weight:800;color:#174b35;margin-bottom:18rpx}.card{background:#fffdf7;border-radius:26rpx;padding:24rpx;margin-bottom:18rpx;box-shadow:0 8rpx 28rpx rgba(23,75,53,.08)}.card-title{font-size:30rpx;font-weight:700;color:#174b35}.muted{font-size:25rpx;color:#68766d;line-height:1.75;margin-top:8rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.step{background:#e8f3e9;border-radius:22rpx;padding:22rpx}.step-num{font-weight:800;color:#2d7756}.chart{width:100%;border-radius:22rpx;background:white;margin-bottom:20rpx}.button{margin-top:24rpx;background:#2d7756;color:white;border-radius:999rpx}.roles{display:flex;flex-wrap:wrap;gap:12rpx}.role{padding:12rpx 18rpx;background:#e8f3e9;color:#174b35;border-radius:999rpx;font-size:24rpx}