page{background:#f8f4e8;color:#20312a;font:28rpx/1.7 -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.page{padding-bottom:64rpx}.wrap{width:686rpx;margin:auto}.hero{padding:96rpx 32rpx 70rpx;background:linear-gradient(145deg,#0f2f20,#2f7d5b);color:#fff;border-radius:0 0 42rpx 42rpx}.eyebrow{display:block;color:#cfe7d7;font-size:22rpx;letter-spacing:4rpx;font-weight:700}.title{display:block;margin-top:18rpx;font:800 62rpx/1.18 serif}.lead{display:block;margin-top:24rpx;color:rgba(255,255,255,.78);font-size:27rpx}.section{padding-top:62rpx}.kicker{display:block;color:#2f7d5b;font-size:21rpx;font-weight:800;letter-spacing:4rpx}.h2{display:block;margin-top:8rpx;color:#0f2f20;font:800 44rpx/1.25 serif}.muted{display:block;margin-top:12rpx;color:#65746b;font-size:25rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:28rpx}.card{padding:30rpx;border:1rpx solid rgba(23,61,43,.1);border-radius:28rpx;background:#fffdf7;box-shadow:0 14rpx 38rpx rgba(23,61,43,.06)}.num{display:block;color:#2f7d5b;font:800 46rpx serif}.label{display:block;margin-top:5rpx;color:#173d2b;font-weight:800}.small{display:block;margin-top:6rpx;color:#7c877f;font-size:21rpx}.flow{margin-top:28rpx}.step{display:flex;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid rgba(23,61,43,.09)}.badge{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;border-radius:18rpx;background:#dcefe1;color:#2f7d5b;font-weight:900}.step-title{display:block;color:#173d2b;font-weight:800}.step-text{display:block;color:#65746b;font-size:24rpx}.dark{margin-top:62rpx;padding:54rpx 32rpx;background:#0f2f20;color:#fff;border-radius:34rpx}.dark .h2{color:#fff}.dark .muted{color:rgba(255,255,255,.66)}.pill{display:inline-block;padding:7rpx 16rpx;border-radius:999rpx;background:#dcefe1;color:#2f7d5b;font-size:21rpx;font-weight:800}.product{margin-top:22rpx;padding:32rpx;border-radius:28rpx;background:#fffdf7}.product-name{display:block;margin-top:12rpx;color:#173d2b;font:800 34rpx serif}.btn{margin-top:28rpx;background:#173d2b!important;color:#fff!important;border-radius:999rpx!important;font-weight:800}.note{margin-top:26rpx;padding:22rpx;border-radius:20rpx;background:#efe8d9;color:#6d675c;font-size:22rpx}.row{display:flex;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid rgba(23,61,43,.09)}.row text:first-child{font-weight:800;color:#173d2b}.row text:last-child{text-align:right;color:#647469}.input,.textarea{width:100%;margin-top:16rpx;padding:22rpx 24rpx;border-radius:20rpx;background:#fff;border:1rpx solid rgba(23,61,43,.13)}.textarea{min-height:170rpx}
